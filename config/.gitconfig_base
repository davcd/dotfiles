[core]
	excludesfile = ~/.gitignore_global
	editor = code --wait
	autocrlf = input
	pager = delta

[alias]
  amend = commit --amend --reuse-message=HEAD
  br = branch
  ci = commit
  co = checkout
  d = diff
  g = grep --break --heading --line-number
  l = log --graph --abbrev-commit --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
  ll = log --graph --abbrev-commit --pretty=oneline
  p = push
  pf = push --force-with-lease
  rh = reset --hard HEAD
  ra = rebase --abort
  rc = rebase --continue
  s = status

[credential]
	helper = osxkeychain

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[rebase]
	autoStash = true

[init]
	defaultBranch = main

[fetch]
	prune = true

[diff]
	tool = vscode
	algorithm = histogram

[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

[merge]
	tool = vscode
	conflictstyle = zdiff3

[mergetool "vscode"]
	cmd = code --wait $MERGED
	trustExitCode = true

[color]
	ui = auto

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
