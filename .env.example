# Prefix for your ssh key names
MACHINE_ID=work

# Your GitHub token, you can generate it at https://github.com/settings/personal-access-tokens/new
# Make sure to provide the following permissions:
# - Read and write access to ssh signing keys and git ssh keys
# - Read access to metadata
GH_TOKEN=your_personal_github_token_here

# Git hosts to configure (one ssh auth key per host), space separated
GIT_HOSTS="github.com github.example.com"

# Token for the non-github.com hosts above (GitHub Enterprise Server), same permissions as GH_TOKEN.
# Optional: without it, the keys are created but you have to upload them manually.
GH_ENTERPRISE_TOKEN=your_enterprise_token_here

# Your git user name and email
GIT_NAME="Robert Smith"
GIT_EMAIL=mail@example.com
